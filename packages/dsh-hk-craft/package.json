{
  "name": "dsh-hk-craft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "dsh-hk-craft — DeepSeek Harness native plugin. Installs into an existing dsh profile; no separate launcher, home, profile, or port.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test --test-isolation=none"
  }
}
