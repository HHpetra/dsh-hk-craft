# OS generated files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
$RECYCLE.BIN/

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cursor / OpenCode — ignore OpenCode wiring; keep .cursor/ project rules & MCP in git
.opencode/
opencode.json

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json

# Build & Dependencies
build/
dist/
bin/
obj/
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
*.tsbuildinfo

# Logs
*.log

# Generated browser plugin bundle (built from src/client/)
/packages/*/lib/client.js

# The client linker under `src/build/` is SOURCE, not build output; the generic
# `build/` rule above would otherwise hide it and only the build script would
# notice (on a clean clone).
!packages/dsh-hk-craft/src/build/
!packages/dsh-hk-craft/src/build/**

# Disposable dsh profile used by smoke tests
/.dsh-dev/

# graft local graph cache — regenerable (run `graft build`)
/graft/

# Local scratch
tmp/
.scratch/_tmp/
.scratch/_worktrees/
